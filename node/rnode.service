[Unit]
Description=F1R3Node
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
DynamicUser=yes
StateDirectory=f1r3node
StateDirectoryMode=0700
ExecStart=/usr/bin/f1r3node run --data-dir=/var/lib/f1r3node --api-host=127.0.0.1 --no-upnp
Restart=on-failure
RestartSec=5s
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
RestrictSUIDSGID=yes
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
